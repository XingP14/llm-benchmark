# Dependencies
node_modules/

# Build output
dist/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Coverage
coverage/

# Output
results/
*.log
data/
test-data/
*.db
*.db-shm
*.db-wal

# Python/tooling caches
__pycache__/
*.py[cod]
.cache/
.tmp/

# Local config files (may contain API keys)
config.json
config-*.json
config.local.json
*.local.json

# Local cron heartbeat logs and agent runtime notes.
